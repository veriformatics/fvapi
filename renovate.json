{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "A Lean bump replays the verification profile's compatibility corpus (Decisions \u2192 Verification profile + gate)",
      "matchPackageNames": [
        "leanprover/lean4"
      ],
      "groupName": "Lean toolchain"
    },
    {
      "description": "Vendored C pins a commit on a moving branch (no release timestamps); tools/vendor-hacl.sh COMMIT relocks the file hashes in the same PR",
      "matchDatasources": [
        "git-refs"
      ],
      "minimumReleaseAge": "0 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Lean toolchain (lean-toolchain)",
      "managerFilePatterns": [
        "/^lean-toolchain$/"
      ],
      "matchStrings": [
        "leanprover/lean4:v(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "leanprover/lean4",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Pinned scanner binaries (tools/tools.lock); the digest column needs tools/pin-tool.sh",
      "managerFilePatterns": [
        "/^tools/tools\\.lock$/"
      ],
      "matchStrings": [
        "(?:^|\\n)(?<depName>\\S+) (?<currentValue>\\S+) linux-x86_64 \\S+ https://github\\.com/(?<packageName>[^/]+/[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Lake packages (lake-manifest.json): git rev of a GitHub package, tracking its inputRev tag",
      "managerFilePatterns": [
        "/^lake-manifest\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<packageName>[^\"]+?)(?:\\.git)?\",[\\s\\S]*?\"rev\":\\s*\"(?<currentDigest>[0-9a-f]{40})\",[\\s\\S]*?\"name\":\\s*\"(?<depName>[^\"]+)\",[\\s\\S]*?\"inputRev\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Vendored upstream C (vendor/*/lock.json): the commit on main",
      "managerFilePatterns": [
        "/^vendor/[^/]+/lock\\.json$/"
      ],
      "matchStrings": [
        "\"upstream\":\\s*\"https://github\\.com/(?<depName>[^\"]+)\",\\s*\"commit\":\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ]
}
